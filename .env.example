# ── Self-hosted mode ──
# Set these for a single-user deployment (no Supabase needed).
# Find your API key + account number at https://octopus.energy/dashboard/developer/
OCTOPUS_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX

# MPAN (13 digits) and meter serial: from your latest bill or the developer dashboard
OCTOPUS_MPAN=1234567890123
OCTOPUS_METER_SERIAL=12A3456789

# IOG tariff identifiers — these change when the tariff is renewed.
OCTOPUS_PRODUCT_CODE=INTELLI-VAR-22-10-14
OCTOPUS_TARIFF_CODE=E-1R-INTELLI-VAR-22-10-14-A

# Optional rate overrides — set these to use fixed rates instead of the API values.
# Values are in pence (inc VAT). Leave unset to use the live Octopus API rates.
# OCTOPUS_PEAK_RATE_OVERRIDE=24.50
# OCTOPUS_OFF_PEAK_RATE_OVERRIDE=7.50
# OCTOPUS_STANDING_CHARGE_OVERRIDE=46.36

# ── Multi-user mode (Supabase) ──
# Set these INSTEAD of the OCTOPUS_* vars above to enable multi-user auth.
# Each user stores their own Octopus credentials via the /setup page.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# AES-256 encryption key for API keys at rest (64 hex chars = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SUPABASE_ENCRYPTION_KEY=
